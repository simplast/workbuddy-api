# ─── CodeBuddy (sole upstream provider) ─────────────────────────────
# OpenAI-protocol provider with CLI request-header fingerprinting.
CODEBUDDY_API_KEY=your-api-key-or-access-token-here

# Copilot Cloud API (internal, mainland China): https://copilot.tencent.com
# CodeBuddy Global API (external): https://www.codebuddy.ai
# CODEBUDDY_BASE_URL=https://copilot.tencent.com

# Comma-separated aliases routed upstream (see GET /v1/models for the full list)
# CODEBUDDY_MODELS=default,glm-5.3,glm-5.3-flash,glm-5.2,glm-5.1
# CODEBUDDY_DIR=~/.codebuddy         # client config dir for local_storage / models.json
# WORKBUDDY_PRODUCT_CONFIG=~/.workbuddy/cache/acc-product-config-v3.json  # model list source
# CODEBUDDY_TARGET_MODEL=actual-upstream-model
# CODEBUDDY_CLI_VERSION=2.110.0   # override auto-detected CLI version

# ─── Routing ─────────────────────────────────────────────────────────
# DEFAULT_MODEL=default

# ─── Local proxy server ──────────────────────────────────────────────
PORT=3456
HOST=127.0.0.1

# ─── HTTPS configuration ────────────────────────────────────────────
# Set HTTPS_ENABLED=1 to enable HTTPS alongside HTTP. You'll need certificate files.
# HTTP runs on PORT, HTTPS runs on HTTPS_PORT (default 3457).
# Generate self-signed certificates for local development:
#   node scripts/gen-cert.js
# HTTPS_ENABLED=1
# HTTPS_PORT=3457
# HTTPS_KEY_PATH=certs/localhost.key
# HTTPS_CERT_PATH=certs/localhost.crt

# ─── Debug & logging ─────────────────────────────────────────────────
# ENABLE_DEBUG_DUMPS=1          # write per-request debug files to logs/requests/
# DEBUG_CAPTURE_FULL_SSE=1      # include raw SSE lines in debug output
# MODELS_DEBUG=1                # trace model-list source discovery (silent by default)
# SYSTEM_PROMPT_FILE=./my-prompt.txt  # path to custom system prompt override file
